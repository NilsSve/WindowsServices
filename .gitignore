# Files to be ignored by git in a DataFlex workspace

# AppHtml
**/apphtml/global.asa

# AppSrc
**/AppSrc/**/*.prn
**/AppSrc/**/*.dep
**/AppSrc/**/*.dbg
**/AppSrc/**/*.exe.manifest
**/AppSrc/**/*.err
**/AppSrc/**/*.fld
**/AppSrc/**/*.pbg
**/AppSrc/**/*.pdp
**/AppSrc/**/*.pkd
**/AppSrc/**/*.prn
**/AppSrc/**/*.prp
loginEncryptionkey.inc

# Data
**/Data/**/*.log
**/Data/**/*.dat
**/Data/**/*.vld
**/Data/**/*.k*
**/Data/**/*.bad
**/Data/**/*.hdr
**/Data/**/*.cch
**/Data/**/*.cfg

# Never track Data\Deploy (developer's local-only baseline copy).
**/Data/Deploy/

# Ship the empty baseline database as real files in Data\ so a fresh clone has
# a working workspace. git tracks these once committed, so it WILL show local
# edits to them. Run skip-local-data.cmd once after cloning to keep your
# private Data\ database out of git. Volatile files above stay ignored.
!**/Data/*.dat
!**/Data/*.hdr
!**/Data/*.k*
!**/Data/Filelist.cfg

# DDSrc
**/DdSrc/**/*.def

# IdeSrc
**/IdeSrc/*.dsk
**/IdeSrc/*.loc
**/IdeSrc/*.mtd

# Programs
**/Programs/*.dbg
**/Programs/*.exe
**/Programs/*.exe.manifest
**/Programs/*.log

# Workspace specific
**/Data/compileheader.h
**/Help/**/*.hnd
**/Help/**/Assets
**/Help/**/HTML
**/Help/**/HTMLHelpWindowsServices
**/Help/**/WindowsServicesHTMLHelp
**/Help/**/Online Help
**/HelpText**/*.*
**/Help/**/DFProgramsStyles.hns
**/Help/DFWinServiceManager.hnd

**/Install
**/Capture
